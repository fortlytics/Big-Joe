# --- Public inventory source (required) ---
# A Google Sheets URL, shared as "Anyone with the link — Viewer".
# Paste the normal browser URL (the one with /d/<id>/edit) — the app converts
# it to the CSV export endpoint itself.
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXXXXXXXXXXX/edit

# --- Admin CMS write-back (required for the /admin panel to publish) ---
# A Google Cloud service account with Editor access to the Sheet above.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the full private key from the service account's JSON key file,
# including the BEGIN/END lines. If your hosting env escapes newlines as
# \n (most do), that's handled automatically.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Image hosting (required for the "Upload photos" button in /admin) ---
# Create a Blob store: Vercel dashboard → your project → Storage → Create
# Database → Blob. Once created and connected to this project, Vercel
# injects BLOB_READ_WRITE_TOKEN automatically — you don't need to copy it
# here for production. For local development, run `vercel env pull` to get
# it into .env.local, or paste it manually from Storage → your store → .env.local tab.
BLOB_READ_WRITE_TOKEN=

# --- Admin login (required for the /admin panel) ---
ADMIN_PASSWORD=choose-a-strong-password
# Any long random string — used to sign admin session tokens. Generate one
# with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Public site config ---
# Used to build absolute permalinks (for OG tags and WhatsApp share links).
# OPTIONAL until you own a real domain: if left unset, the app automatically
# uses your Vercel production deployment's stable URL (<project>.vercel.app)
# instead — share links work correctly from day one either way. Set this
# once you have a real domain, and update it (nothing else needs to change).
NEXT_PUBLIC_SITE_URL=
# WhatsApp number in international format, digits only, no + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=2348181597529
NEXT_PUBLIC_PHONE_DISPLAY=0818 159 7529
